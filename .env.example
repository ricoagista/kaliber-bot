# Token autentikasi ke Web Admin (/api/*). Wajib diisi, minimal 24 karakter.
ADMIN_TOKEN=ganti_dengan_token_admin_minimal_24_karakter

# Kunci rahasia penurunan KEK AES-256-GCM untuk enkripsi API key di SQLite. Wajib diisi, minimal 32 karakter.
SECRET_KEY=ganti_dengan_secret_key_minimal_32_karakter_acak

# Password tambahan untuk fitur buka/reveal API key di Web Admin. Opsional (jika kosong, otomatis memakai ADMIN_TOKEN; jika diisi minimal 12 karakter).
REVEAL_PASSWORD=

# Port HTTP server Web Admin. Opsional, default 3000.
PORT=3000

# Hostname binding HTTP server. Default 127.0.0.1 (di dalam container Podman diset ke 0.0.0.0).
HOST=127.0.0.1

# Set TRUST_PROXY=true jika bot dijalankan di belakang reverse proxy / Cloudflare Tunnel agar IP klien terbaca dari CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY=false

# Direktori penyimpanan database SQLite (kaliber.db) dan kredensial WhatsApp (wa-auth/).
DATA_DIR=./data

# Zona waktu runtime proses Node.js.
TZ=Asia/Jakarta

# Seed model LLM awal jika belum diatur lewat Web Admin.
DEFAULT_MODEL=

# Level log awal untuk pino (trace | debug | info | warn | error | fatal). Default warn.
LOG_LEVEL=warn
