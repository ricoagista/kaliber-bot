PORT=3000
DATA_DIR=/data
TZ=Asia/Jakarta
ADMIN_TOKEN=ganti-dengan-token-panjang-acak-minimal-24-karakter
SECRET_KEY=ganti-dengan-kunci-panjang-acak-minimal-32-karakter
# Password untuk tombol "Lihat key" di web. Hanya dibaca dari env, minimal 12 karakter.
REVEAL_PASSWORD=ganti-dengan-password-reveal-minimal-12-karakter
ROUTER_URL=http://host.containers.internal:20128/v1
ROUTER_KEY=isi-api-key-9router
DEFAULT_MODEL=nama-model-atau-combo
# Level log awal (trace|debug|info|warn|error|fatal). Setelah itu diubah lewat web.
LOG_LEVEL=warn
