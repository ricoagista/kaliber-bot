[Unit]
Description=Kaliber Bot - WhatsApp + web admin (LSO Kaliber UMM)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/kaliber-bot:latest
ContainerName=kaliber-bot
AutoUpdate=none
PublishPort=127.0.0.1:3000:3000
# Fallback bila host.containers.internal tidak meresolve 9router di host:
# aktifkan Network=host, hapus/komentari PublishPort, dan set Environment=HOST=127.0.0.1
# Network=host
Volume=kaliber-data:/data:U
EnvironmentFile=%h/.config/kaliber-bot/env
Environment=HOST=0.0.0.0
Environment=TZ=Asia/Jakarta
Memory=256m
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/healthz || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
LogDriver=journald
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
