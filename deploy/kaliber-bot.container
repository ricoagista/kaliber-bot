[Unit]
Description=Kaliber Bot - WhatsApp + web admin (LSO Kaliber UMM)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/kaliber-bot:latest
ContainerName=kaliber-bot
AutoUpdate=none
Network=host
Volume=kaliber-data:/data
EnvironmentFile=%h/.config/kaliber-bot/env
Environment=TZ=Asia/Jakarta
Memory=256m
LogDriver=journald
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
