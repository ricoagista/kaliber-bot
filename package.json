{
  "name": "kaliber-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chatbot WhatsApp + web admin ringan untuk LSO Kaliber (UMM Informatika)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "test:injection": "npm run build:test && node dist-test/scripts/test-injection.js",
    "test:load": "npm run build:test && node dist-test/scripts/test-load.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
